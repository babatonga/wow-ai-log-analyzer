# =====================================================================
# WoW AI Log Analyzer — environment configuration
# Copy to .env and adjust values. Docker Compose reads this file.
# =====================================================================

# --- General ---
APP_NAME=WoW AI Log Analyzer
# production | development
APP_ENV=production
LOG_LEVEL=INFO
TZ=Europe/Berlin

# Public base URL of the frontend (used in emails, OAuth callbacks, CORS).
PUBLIC_BASE_URL=http://localhost:3000

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# IMPORTANT: generate a long random string, e.g. `openssl rand -hex 64`
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
# Comma-separated origins allowed to call the API (frontend URLs).
# Add your LAN IP if you access the app from another device, e.g.:
#   http://localhost:3000,http://192.168.1.20:3000,https://wow.your-domain.tld
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=wowanalyzer
POSTGRES_USER=wowanalyzer
POSTGRES_PASSWORD=change-me

# --- Redis (cache + arq queue) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Warcraft Logs API v2 ---
# Create a client at https://www.warcraftlogs.com/api/clients/ (CONFIDENTIAL,
# i.e. "Public Client" UNCHECKED). When you register, list these redirect URLs
# (comma-separated):
#   https://<your-domain>/api/v1/auth/wcl/callback
#   http://localhost:8000/api/v1/auth/wcl/callback
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_API_URL=https://www.warcraftlogs.com/api/v2/client
WCL_USER_API_URL=https://www.warcraftlogs.com/api/v2/user
WCL_OAUTH_TOKEN_URL=https://www.warcraftlogs.com/oauth/token
WCL_OAUTH_AUTHORIZE_URL=https://www.warcraftlogs.com/oauth/authorize
# Must EXACTLY match one of the redirect URLs registered above. The browser is
# redirected here after the user authorises the connection on warcraftlogs.com.
WCL_REDIRECT_URI=http://localhost:8000/api/v1/auth/wcl/callback
WCL_OAUTH_SCOPE=view-user-profile

# --- AI provider ---
# Options:
#   "anthropic" → cloud Claude (set ANTHROPIC_API_KEY).         ← default
#   "openai"    → OpenAI / Azure OpenAI (set OPENAI_API_KEY [+ OPENAI_BASE_URL]).
#   "local"     → bundled llama.cpp container on your own GPU. Requires
#                 NVIDIA Container Toolkit + ≥24 GB VRAM. Opt in with:
#                    docker compose --profile local-ai up -d
#                 See docs/SETUP.md §8 for the full local-AI walkthrough.
#   "disabled"  → app-wide AI is off; users can still bring their own
#                 API key via the profile (BYOK).
#
# Admins can flip this at runtime in the admin UI — the value here is
# only the boot-time default.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Default model when ai_provider is "anthropic" or "openai" (admins can override
# in the UI). Ignored for "local" — that model is set in the admin UI's
# Local-AI card (or by LOCAL_AI_* below on first boot).
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=16000

# --- AI: OpenAI cloud (only used when AI_PROVIDER=openai) ---
OPENAI_API_KEY=
# Leave empty for the standard OpenAI endpoint. Set this for Azure OpenAI or
# any third-party OpenAI-compatible cloud.
OPENAI_BASE_URL=
# Reasoning effort for GPT-5 / o-series models (gpt-5.4-mini, o1-mini, …).
# Without this, OpenAI's Chat Completions defaults to ~0 reasoning tokens.
# Valid: minimal | low | medium | high. Empty = OpenAI default.
# ``high`` ≈ 5–10× more output tokens but visibly deeper coaching findings.
OPENAI_REASONING_EFFORT=

# --- AI: local model via the bundled llama.cpp-server container ---
# Used when AI_PROVIDER=local. We use llama.cpp's official server image because
# Ollama's bundled llama.cpp lags upstream and chokes on bleeding-edge model
# architectures (e.g. qwen35moe). Inside Compose the URL stays as-is.
LOCAL_AI_BASE_URL=http://local-ai:8080/v1
# Hugging Face GGUF source: llama-server downloads <repo>/<file> on first
# start. Pick a quantisation that fits your VRAM:
#   IQ3_M  ~15 GB
#   Q4_K_M ~21 GB  ← default, sweet spot for 24-32 GB
#   Q5_K_P ~28 GB
#   Q6_K_P ~31 GB
LOCAL_AI_HF_REPO=HauhauCS/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive
LOCAL_AI_HF_FILE=Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf
# Short alias used as the OpenAI "model" field. Must match what the backend
# sends to /v1/chat/completions.
LOCAL_AI_MODEL=qwen3.6-35b-a3b-q4_k_m
# llama-server doesn't authenticate; the OpenAI SDK still requires *something*.
LOCAL_AI_API_KEY=dummy
# Reasoning / chain-of-thought for Qwen 3.5/3.6 and similar models. ``true``
# trades ~20-50s of inference for noticeably better analysis quality (the
# model thinks through buff uptimes, cast counts, top-log deltas before
# producing the structured JSON). Cloud providers ignore this flag.
LOCAL_AI_ENABLE_THINKING=true
# Context window in tokens. The analysis prompt easily hits 18-20k tokens
# when buffs+debuffs+damage_taken+top-log details are included; 64k gives
# comfortable headroom and still fits in 32 GB VRAM for this MoE model.
# Lower this if you run out of VRAM at load time.
LOCAL_AI_CTX_SIZE=65536

# --- SMTP (local relay, no auth/TLS) ---
SMTP_HOST=smtp.local
SMTP_PORT=25
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=wowanalyzer@example.com
SMTP_FROM_NAME=WoW AI Log Analyzer

# --- Top-Logs weekly fetcher ---
# Cron expression in UTC. Default: Wednesday 08:00 UTC, which is ~1-3 hours
# after the EU weekly reset (Wed 07:00 CET/CEST). Daily would just burn the
# WCL rate budget — the leaderboard barely moves intra-week.
TOP_LOGS_CRON=0 8 * * 3
# How many top entries to keep per class/spec/encounter.
TOP_LOGS_LIMIT=25
# WCL region filter ("EU", "US", "KR", or empty for global).
TOP_LOGS_REGION=EU
# Raid difficulty for top-log queries (5=Mythic, 4=Heroic, 3=Normal).
TOP_LOGS_RAID_DIFFICULTY=5
# For HPS rankings, drop logs with fewer healers than this (avoids inflated
# single-healer "log-run" performances dominating the comparison).
TOP_LOGS_MIN_HEALERS=3
# How many top performers per spec/encounter to also fetch DETAIL data for
# (casts, gear, buffs, talents). Lower = faster refresh, fewer WCL API calls.
TOP_LOGS_DETAIL_COUNT=5

# --- Initial admin (created on first start if missing) ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme-at-first-login

# --- Feature flags ---
# admins can flip this in the UI later
ALLOW_REGISTRATION=true

# --- Captcha (Cloudflare Turnstile, optional) ---
# Protects login, register, forgot-password and accept-invite from automated
# abuse. To enable, set TURNSTILE_ENABLED=true AND fill BOTH keys below.
# Both empty / TURNSTILE_ENABLED=false → captcha disabled, no widget rendered.
# Get a free pair at https://dash.cloudflare.com/?to=/:account/turnstile.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
# Cloudflare site key (public — sent to the browser by /api/v1/config).
TURNSTILE_SITE_KEY=

# --- Admin Docker control (optional, opt-in) ---
# When True the admin UI exposes a "System" card that lists the compose stack
# containers and lets admins start/stop/restart them. The local-ai container
# is also auto-started/stopped when ai_provider toggles between "local" and
# anything else.
# SECURITY: this requires /var/run/docker.sock mounted into the backend
# container (already configured in docker-compose.yml). Mounting the socket
# grants the backend root-on-host privileges. Only enable on single-tenant
# self-hosted instances where the admin == the host operator.
ADMIN_DOCKER_CONTROL=false

# --- Frontend (Next.js) ---
# The browser uses same-origin /api/* URLs; the reverse proxy in front
# routes /api/* to the backend and /* to the frontend. No baked URL
# means the same image runs on any host (localhost, your-domain.tld, …).
# For `npm run dev` outside compose, see frontend/next.config.ts.
DEFAULT_LOCALE=en

# --- Imprint (rendered on /legal/imprint, required by German § 5 DDG) ---
# Read at request time by the imprint server component — no rebuild needed
# when these values change. Empty fields render as visible [Platzhalter]
# so it's obvious what still needs filling.
IMPRINT_NAME=
IMPRINT_STREET=
IMPRINT_POSTAL_CITY=
IMPRINT_COUNTRY=Deutschland
IMPRINT_EMAIL=
# Phone is optional — leave empty to omit the line entirely from the imprint.
IMPRINT_PHONE=

# --- Container image overrides (optional) ---
# When set, the corresponding compose service pulls the image from a
# registry instead of building locally. CI publishes to ghcr.io after
# every push to main + on each git tag, so production servers can pin
# a specific release (e.g. ``...:0.2.0``) or follow ``...:latest``.
# Leave unset for local-only development — compose builds it.
#
# Worker reuses BACKEND_IMAGE (same image, different command).
# BACKEND_IMAGE=ghcr.io/<your-name>/wow-ai-log-analyzer-backend:latest
# FRONTEND_IMAGE=ghcr.io/<your-name>/wow-ai-log-analyzer-frontend:latest
# LOCAL_AI_IMAGE=ghcr.io/<your-name>/wow-ai-log-analyzer-local-ai:latest
